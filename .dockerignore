# Everything the image does not need. The COPY lines in the Dockerfile are
# explicit, so this is defence in depth plus a smaller build context.
.git
.gitignore
.claude
PLANS
README.md
parsed-rules-aug-2026.md
prolog/test
Dockerfile
.dockerignore
*.log
httpd.log

# The stylesheet toolchain. web/app.css is generated from web/app.src.css and
# committed, so the image carries the output and never needs the input, the
# compiler, or node. web/fonts/NOTICE.md and OFL.txt are deliberately NOT
# excluded: the licence requires them to travel with the font files.
node_modules
package.json
package-lock.json
.impeccable.md
web/app.src.css
web/check-contrast.mjs
